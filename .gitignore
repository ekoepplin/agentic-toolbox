# Vendored external skill sets — consumed, not developed here. Re-fetched from
# upstream rather than committed. See docs/adr/0001.
.agents/skills/

# Symlinks to the vendored skill set, created by the dock step
# (.devcontainer/scripts/install-skills.sh). Local-only, never committed. See docs/adr/0001.
.claude/skills/

# Python bytecode from local skill scripts
__pycache__/
*.pyc

# Ralph backend/model preferences, sourced by the ralph scripts (local dev aid)
.env.ralph

# remote-pi writes per-machine runtime state (agent name, relay toggle) here;
# it appears in the repo only because the base is bind-mounted into the container.
.pi/remote-pi/

# Per-user Claude Code overrides. Ignored globally on the Mac, but the container
# has no global gitignore — without this the dock probe flags a dirty base.
.claude/settings.local.json

# macOS Finder metadata
.DS_Store
