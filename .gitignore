# Vendored external skill sets — consumed, not developed here. Re-fetched from
# upstream rather than committed. See docs/adr/0001.
.agents/skills/

# Symlinks to the vendored skill set, created by scripts/bootstrap-dev.sh for
# this repo's own Claude sessions. Local-only, never committed. See docs/adr/0001.
.claude/skills/

# Python bytecode from local skill scripts
__pycache__/
*.pyc

# Local dev-workflow aids — the Matt-Pocock pipeline harness (MATT-WORKFLOW.md +
# ralph loop) and reference notes. Used to develop this toolbox, never shipped or
# committed. Same rationale as the vendored skill set above (docs/adr/0001).


# Ralph backend/model preferences, sourced by the ralph scripts (local dev aid)
.env.ralph

# Pi harness local config (skill exposure via .pi/settings.json, ralph
# guardrail extension). Local dev aid, never committed — same rationale as
# agentic-workflow/ (docs/adr/0001)..pi/

# remote-pi writes per-machine runtime state (agent name, relay toggle) here;
# it appears in the repo only because the base is bind-mounted into the container.
.pi/remote-pi/
