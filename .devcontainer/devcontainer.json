{
  // Thin devcontainer wrapper (issue #9). The workbench — base image, the
  // docked base at its mirrored host path, mounts, SSH port, sshd startup —
  // lives in the root compose stack (compose.yaml). This file only tells
  // VS Code which service to open and what to run on first create.
  //
  //   make image  →  Reopen in Container  →  lands in the compose workbench
  "name": "agentic-toolbox",

  "dockerComposeFile": "../compose.yaml",
  "service": "workbench",
  // The mirrored host path — same path the compose volume mounts (BASE_PATH).
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "node",

  // Local models (host.docker.internal:8000, reached via the host's SSH
  // tunnel) are used through pi: pi-zgx | pi-flashnext — see
  // .devcontainer/claude-aliases.sh; diagnose with check-vllm.
  "remoteEnv": {
    "VLLM_DEFAULT_MODEL": "qwen",
    // API keys forwarded from the host environment.
    "TAVILY_API_KEY": "${localEnv:TAVILY_API_KEY}",
    "NEWS_API_KEY": "${localEnv:NEWS_API_KEY}",
    "PEXELS_API_KEY": "${localEnv:PEXELS_API_KEY}",
    "PIXABAY_API_KEY": "${localEnv:PIXABAY_API_KEY}",
    "GH_TOKEN": "${localEnv:GITHUB_ROBOT_MAC_MINI}",
    "GITHUB_TOKEN_MACBOOK": "${localEnv:GITHUB_TOKEN_MACBOOK}",
    "GITHUB_ROBOT_MAC_MINI": "${localEnv:GITHUB_ROBOT_MAC_MINI}",
    "ENABLE_LSP_TOOL": "1",
    "RTK_MODE": "token-efficient",
    "DISABLE_AUTOUPDATER": "1"
  },

  // Runs once after creation. Harness wiring (dock step) and sshd run on
  // every start via the compose service command.
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",

  "forwardPorts": [3000],
  // Never auto-forward 8000: VS Code would plant a 127.0.0.1:8000 listener on
  // the host that shadows the SSH tunnel to the model server (Docker routes
  // host.docker.internal to host loopback).
  "portsAttributes": {
    "8000": { "onAutoForward": "ignore" }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "remote.autoForwardPorts": false
      },
      "extensions": [
        "editorconfig.editorconfig",
        "ms-vscode.vscode-json",
        "donjayamanne.python-extension-pack"
      ]
    }
  }
}
